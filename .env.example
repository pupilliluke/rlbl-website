# Copy to .env.local (gitignored) and fill in real values.
# .env.local takes precedence over .env, neither is committed.

# REQUIRED — Postgres connection string (get from Neon dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# REQUIRED — Admin panel password (anything non-trivial)
REACT_APP_ADMIN_PASSWORD=changeme

# OPTIONAL — backend port (defaults to 5000)
# PORT=5000

# OPTIONAL — defaults to 'development' locally
# NODE_ENV=development
